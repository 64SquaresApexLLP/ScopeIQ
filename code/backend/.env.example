# Copy to backend/.env and edit. Real environment variables win over this file.
# Environment: dev (verbose logging) | test | prod (minimal logging)
SCOPEIQ_ENV=dev

# Any setting in scopeiq/config/*.yaml can be overridden as SCOPEIQ__<SECTION>__<KEY>
# SCOPEIQ__LOGGING__LEVEL=INFO
# SCOPEIQ__LOGGING__LOG_PAYLOADS=false
# SCOPEIQ__ENGINE__TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# SCOPEIQ__API__TOKEN_SECRET=change-me

# Snowflake instead of the local SQLite database (see snowflake/EXECUTION_GUIDE.md)
# SCOPEIQ__DATABASE__BACKEND=snowflake
# SCOPEIQ__DATABASE__SNOWFLAKE__ACCOUNT=myorg-myaccount
# SCOPEIQ__DATABASE__SNOWFLAKE__USER=SCOPEIQ_SVC
# SCOPEIQ__DATABASE__SNOWFLAKE__AUTHENTICATOR=snowflake_jwt
# SCOPEIQ__DATABASE__SNOWFLAKE__PRIVATE_KEY_PATH=C:/keys/scopeiq_svc.p8
# SCOPEIQ__DATABASE__SNOWFLAKE__ROLE=SCOPEIQ_DEV_APP
# SCOPEIQ__DATABASE__SNOWFLAKE__WAREHOUSE=SCOPEIQ_DEV_WH
# SCOPEIQ__DATABASE__SNOWFLAKE__DATABASE=SCOPEIQ_DEV
# SCOPEIQ__REFERENCE__SOURCE=database

# SharePoint document library (default: a local folder that stands in for it - nothing to configure)
# SCOPEIQ__SHAREPOINT__PROVIDER=graph
# SCOPEIQ__SHAREPOINT__LIBRARY_ROOT=Ericsson-Scoping/Sites
# SCOPEIQ__SHAREPOINT__GRAPH__TENANT_ID=
# SCOPEIQ__SHAREPOINT__GRAPH__CLIENT_ID=
# SCOPEIQ__SHAREPOINT__GRAPH__CLIENT_SECRET=
# SCOPEIQ__SHAREPOINT__GRAPH__SITE_HOSTNAME=contoso.sharepoint.com
# SCOPEIQ__SHAREPOINT__GRAPH__SITE_PATH=/sites/ScopeIQ
# SCOPEIQ__SHAREPOINT__GRAPH__DRIVE_NAME=Documents
